# ------------------------------------------------------------------
# PIP AI Platform - environment variables
# Copy this file to `.env` and adjust the values for your machine.
#   cp .env.example .env
# ------------------------------------------------------------------

# --- Database (used by the backend) ---
DATABASE_URL=postgresql+psycopg2://pip_user:pip_password@localhost:5432/pip_db

# --- Local AI inference (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- Allowed CORS origins (comma-separated) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Docker Compose overrides (optional; defaults are in compose.yaml) ---
POSTGRES_USER=pip_user
POSTGRES_PASSWORD=pip_password
POSTGRES_DB=pip_db

MINIO_ROOT_USER=pipadmin
MINIO_ROOT_PASSWORD=pipminio123

PGADMIN_DEFAULT_EMAIL=admin@pip.com
PGADMIN_DEFAULT_PASSWORD=admin123
